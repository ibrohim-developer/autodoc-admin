# Normalise line endings to LF in the repo and on checkout everywhere.
# Without this, Windows checkouts rewrite files to CRLF, which produces
# whole-file diffs between platforms and can break shell hooks like .husky/pre-commit.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
