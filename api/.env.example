# Copy to api/.env. Validated at startup by src/config/env.ts — a bad value stops the boot.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# `pnpm dev:db` starts this local Postgres (embedded, no install needed).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/autodoc

# 32+ random characters:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Exactly 32 random bytes, base64:  openssl rand -base64 32
# Encrypts 2FA secrets. Changing it disables every user's 2FA (they set it up again).
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=

# Where the dashboard runs. Used for the CSRF origin check and in invite links.
ADMIN_ORIGIN=http://localhost:5173

# Secure cookies need HTTPS. false only for local http.
COOKIE_SECURE=false

# Interactive API docs at /api/docs.
SWAGGER=true

# Built dashboard, served by the API in production (relative to the api folder).
DASHBOARD_DIST=../dashboard/dist

# Uploaded files (relative to the api folder): public/ is served at /media, private/ never is.
STORAGE_DIR=storage

# The public site. SITE_ORIGIN is what visitors open (preview links point there);
# SITE_INTERNAL_URL is how this server reaches it directly to refresh pages after publishing.
SITE_ORIGIN=http://localhost:3000
SITE_INTERNAL_URL=http://127.0.0.1:3000

# Shared with the site's .env (same values on both sides). 32+ random characters each:
#   openssl rand -base64 48
SITE_API_TOKEN=dev-only-site-token-change-me-dev-only-site-token
REVALIDATE_SECRET=dev-only-revalidate-secret-change-me-dev-only
PREVIEW_SECRET=dev-only-preview-secret-change-me-dev-only-preview
