# `pnpm add x` writes "1.2.3", not "^1.2.3". This project pins exact versions so
# the lockfile is the only thing deciding what gets installed.
save-exact=true

# Deliberately NOT engine-strict=true. react-router@8 declares node >=22.22.0 and
# enforcing it turns a working setup into a failed install on 22.19.x, where
# everything in fact runs fine. `engines` in package.json still warns.
